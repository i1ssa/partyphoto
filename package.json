{
  "name": "partyphoto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node frontend/scripts/next.mjs dev --hostname 0.0.0.0",
    "build": "npm run db:generate && node frontend/scripts/next.mjs build",
    "start": "node frontend/scripts/next.mjs start",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:validate": "prisma validate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "test:auth": "node --env-file=.env --test backend/tests/auth.integration.test.mjs",
    "test:ui": "node --env-file=.env node_modules/@playwright/test/cli.js test --config frontend/playwright.config.ts",
    "test:events": "node --env-file=.env --test backend/tests/events.integration.test.mjs",
    "test:media": "node --env-file=.env --test backend/tests/media.integration.test.mjs backend/tests/media-recovery.integration.test.mjs",
    "test:engagement": "node --env-file=.env --test backend/tests/engagement.integration.test.mjs",
    "test:views": "node --env-file=.env --test backend/tests/views.integration.test.mjs",
    "test:password-reset": "node --env-file=.env --test backend/tests/password-reset.integration.test.mjs",
    "test:email": "node --experimental-strip-types --conditions=react-server --test backend/tests/reset-email.test.mjs",
    "test:forgot-password": "node --env-file=.env --test backend/tests/forgot-password.integration.test.mjs",
    "test:admin": "node --env-file=.env --test backend/tests/admin.integration.test.mjs",
    "admin:reset-password": "node --env-file=.env backend/scripts/reset-password.mjs",
    "admin:bootstrap": "node --env-file=.env backend/scripts/admin-bootstrap.mjs",
    "demo:prepare": "node backend/scripts/prepare-demo.mjs",
    "demo:start": "node backend/scripts/start-demo.mjs",
    "test:demo": "node --test backend/tests/demo-runtime.test.mjs",
    "test:demo:integration": "node --env-file=.env --test backend/tests/demo.integration.test.mjs",
    "storage:install": "sh backend/infra/storage/install.sh",
    "storage:dev": "node --env-file=.env backend/infra/storage/start.mjs",
    "storage:check": "node --env-file=.env backend/infra/storage/check.mjs",
    "worker:media": "node --env-file=.env backend/scripts/media-worker.mjs",
    "worker:media:once": "node --env-file=.env backend/scripts/media-worker.mjs --once"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@next/env": "16.3.8",
    "@prisma/client": "6.19.0",
    "argon2": "^0.45.1",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
